# Neon Postgres connection strings (see DEPLOY.md).
# DATABASE_URL: pooled connection, used by the running app.
# DIRECT_URL: unpooled connection, used only for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-string"

# The first coach account, created by `npm run seed`. Change the PIN after first login.
COACH_NAME="Coach Quinones"
COACH_USERNAME="coach"
COACH_PIN="1927"
